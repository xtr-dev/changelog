{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@xtr-dev/changelog/schema/versions.schema.json",
  "title": "@xtr-dev/changelog versions.json / archive.json",
  "type": "object",
  "required": ["schemaVersion", "versions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "versions": {
      "description": "Releases, newest first.",
      "type": "array",
      "items": { "$ref": "#/definitions/versionEntry" }
    }
  },
  "definitions": {
    "versionEntry": {
      "type": "object",
      "required": ["version", "date", "commit", "breaking", "groups"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "description": "Semver, without the tag prefix." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "commit": {
          "type": ["string", "null"],
          "description": "Short SHA of the newest commit included in this release."
        },
        "breaking": { "type": "boolean" },
        "groups": {
          "type": "object",
          "description": "Changes by group key (breaking, features, fixes, other, or custom groups).",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/change" }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["type", "scope", "description", "commit", "breaking", "notes"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "scope": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "commit": { "type": "string", "description": "Short SHA." },
        "hash": { "type": "string", "description": "Full SHA." },
        "author": { "type": "string" },
        "breaking": { "type": "boolean" },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "text"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
